# =============================================================================
# Craftinator-v2 Environment Variables Configuration Example
# =============================================================================
# NOTE: In Vite, variables must be prefixed with `VITE_` to be exposed to the client.
# Access them in your code via `import.meta.env.VITE_VARIABLE_NAME`.
# Copy this file to `.env` or `.env.local` and update the values for your setup.

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api

# API Request Timeout (in milliseconds)
VITE_API_TIMEOUT=15000

# Mock Fallback Mode (true: uses static/mock data if backend is offline or not set up)
VITE_ENABLE_MOCK_API=true

# Current Application Environment (development | staging | production)
VITE_APP_ENV=development

# Optional Integrations / Keys (for future services)
# VITE_PAYMENT_GATEWAY_KEY=pk_test_placeholder
# VITE_STORAGE_UPLOAD_URL=http://localhost:5000/api/upload
